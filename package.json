{
  "name": "entradasya-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.ts",
    "start": "node nginx/start.ts",
    "check:nginx": "node nginx/start.ts --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "node --test tests/*.test.ts",
    "package": "npm run build && node scripts/package.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "jsqr": "^1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.65.1"
  }
}
